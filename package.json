{
  "name": "osmdle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A higher/lower game where players guess which OpenStreetMap feature is more common.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Seb0927/osmdle.git"
  },
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "@modelcontextprotocol/sdk": "1.32.1"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "biome check",
    "format": "biome format --write",
    "typegen": "next typegen",
    "typecheck": "npm run typegen && tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "data:sync": "node scripts/sync-counts.mjs",
    "data:sync:report": "node scripts/sync-counts.mjs --report",
    "data:validate": "node scripts/validate-data.mjs",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "lefthook": "2.2.2",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  }
}
